# Server
PORT=5000
NODE_ENV=development

# Mongo
MONGO_URI=mongodb://localhost:27017/authforge

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Required, >=32 chars, and the two must differ. The app refuses to start otherwise.
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Rate limiting
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5

# CORS
CLIENT_ORIGIN=http://localhost:3000

# Two-factor attempt throttle (per user) and per-account lockout
TWO_FACTOR_RATE_LIMIT_MAX_ATTEMPTS=5
TWO_FACTOR_RATE_LIMIT_WINDOW_MS=900000
ACCOUNT_LOCK_THRESHOLD=10
ACCOUNT_LOCK_DURATION_MS=900000
API_RATE_LIMIT_MAX=100  # coarse per-IP requests/minute (in-memory, per process)
